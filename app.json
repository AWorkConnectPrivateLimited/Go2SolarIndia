{
  "expo": {
    "name": "Go2Solar",
    "slug": "go2solar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "assets/images/*",
      "assets/icon.png",
      "assets/splash.png",
      "assets/adaptive-icon.png",
      "assets/favicon.png"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.go2solar.app",
      "config": {
        "googleMapsApiKey": "${process.env.EXPO_PUBLIC_GOOGLE_MAPS_API_KEY}"
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Go2Solar to access your photos.",
        "NSCameraUsageDescription": "Allow Go2Solar to access your camera.",
        "NSMicrophoneUsageDescription": "Allow Go2Solar to access your microphone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.go2solar.app",
      "config": {
        "googleMaps": {
          "apiKey": "${process.env.EXPO_PUBLIC_GOOGLE_MAPS_API_KEY}"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Go2Solar to use your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Go2Solar to access your photos.",
          "cameraPermission": "Allow Go2Solar to access your camera."
        }
      ]
    ],
    "scheme": "go2solar",
    "experiments": {
      "tsconfigPaths": true
    },
    "newArchEnabled": false,
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "1f600e99-8151-45d1-bb6e-b791fdd67c16"
      }
    },
    "owner": "soudaabhinav"
  }
}
