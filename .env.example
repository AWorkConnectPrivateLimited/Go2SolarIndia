# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-supabase-project-url.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Razorpay Configuration (if needed)
EXPO_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id
EXPO_PUBLIC_RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Google Maps API Key (if needed)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# App Environment
EXPO_PUBLIC_APP_ENV=development 